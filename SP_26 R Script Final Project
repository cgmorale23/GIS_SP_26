demographic_data = read_csv("Elephant Demographics 2026(ALL).csv")

# Data Cleaning: Demographic ----

#remove columns
demographic_data = demographic_data %>% 
  select(-RELATION, -`FORMERLY KNOWN AS`, -`OTHER NOTES`)

#rename columns

names(demographic_data)

demographic_data = demographic_data %>% rename(
  herd_number = "HERD #  (COLLOQUIAL NAME)",
  personal_name = "COLLOQUIAL NAME",
  collared = "COLLARED",
  age = "AGE",
  dob = "DOB",
  age_class = "ELEPHANTS"
)

# change data type
demographic_data = demographic_data %>% mutate(
  across(c(age, dob), as.numeric),
  across(c(age_class, collared), as.factor),
  herd_number = as.character(herd_number)
)

#make a column for gender and mutate so age class is just age class
demographic_data <- demographic_data %>%
  mutate(
    age_class_simple = case_when(
      str_detect(age_class, "^AF") ~ "A",
      str_detect(age_class, "^SA") ~ "SA",
      str_detect(age_class, "^JUV") ~ "JUV",
      str_detect(age_class, "^INF") ~ "INF",
      TRUE ~ NA_character_
    ),
    
    sex = case_when(
      str_detect(age_class, "^AF") ~ "Female",
      str_detect(age_class, "^SAF") ~ "Female",
      str_detect(age_class, "^SAM") ~ "Male",
      str_detect(age_class, "-M-") ~ "Male",
      str_detect(age_class, "-F-") ~ "Female",
      TRUE ~ NA_character_
    )
  )

demographic_data = demographic_data %>% 
  slice(1:89) # get rid of all the weird empty rows

demographic_data = demographic_data %>% mutate(
  sex = as.factor(demographic_data$sex))

demographic_data$age_class_simple = factor(
  demographic_data$age_class_simple,
  levels = c("INF", "JUV", "SA", "A")
)

