# Kernel Density Estimates

# first need to project sf into a metric CRS for calculations

collar_sf <- st_as_sf(
  collar_data, 
  coords = c("longitude", "latitude"),
  crs = 4326
)

collar_sf_utm <- st_transform(collar_sf, 32735)

# amt package needs x/y coordinates 

coords <- st_coordinates(collar_sf_utm)

collar_equal_proj <- collar_sf_utm %>%
  st_drop_geometry() %>%
  mutate(
    x_ = coords[,1],
    y_ = coords[,2]
  )

# make amt tracks

amt_tracks <- make_track(
  collar_equal_proj,
  .x = x_,
  .y = y_,
  .t = Timestamp,
  id = TagId,
  crs = st_crs(collar_sf_utm)$wkt
)

## In my first attempt, amt didn't recognize ID column in KDE calculations
## so build herd separately

amt_tracks_by_herd <- collar_equal_proj %>%
  group_by(TagId) %>%
  group_split() # creates a list of dataframes (each herd is a df)

# build KDEs separately

kde_list <- lapply(amt_tracks_by_herd, function(df){ #loops over each herd's df
  herd_id <- unique(df$TagId) # lets herd ID be added back to polygon later on
  
  trk <- make_track( #makes amt style tracks
    df,
    .x = x_,
    .y = y_,
    .t = Timestamp,
    id = TagId,
    crs = st_crs(collar_sf_utm)$wkt #amt package needs full CRS def, which $wkt provides
  )
  
  kde <- hr_kde(trk) # estimate utilization distribution for each herds amt movement data
  
  kde_50 <- hr_isopleths(kde, levels = 0.50) %>% # extract 50% isopleth
    mutate(TagId = herd_id)
  
  kde_95 <- hr_isopleths(kde, levels = 0.95) %>% # extract 95% isopleth
    mutate(TagId = herd_id)
  
  list(kde_50 = kde_50, kde_95 = kde_95) # returns a list with kde 50 and 90 for each herd
})

# combine all together
kde_50 <- do.call(rbind, lapply(kde_list, `[[`, "kde_50")) #[[ is an operator signifying to pull out the element named kde_50 from each list item
kde_95 <- do.call(rbind, lapply(kde_list, `[[`, "kde_95")) #do.call + rbind combines into one list

#check names
names(kde_50)
names(kde_95)

