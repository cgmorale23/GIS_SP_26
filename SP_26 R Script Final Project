## Model ----

# create time grouping variable

cordon_cross_ndvi_w_periods <- cordon_cross_ndvi %>%
  mutate(period = floor_date(date, unit = "16 days"))

### Poisson ----
model_poisson <- glmmTMB(
  n_crossings ~ TagId + ndvi + (1 | period),
  data = cordon_cross_ndvi_w_periods,
  family = poisson
)

summary(model_poisson)

## check overdispersion

overdispersion <- sum(residuals(model_poisson, type = "pearson")^2) / df.residual(model_poisson)
overdispersion

## do herds respond differently to ndvi? 

##### Visualize ----

ggplot(cordon_cross_ndvi_w_periods, aes(x = ndvi, y = n_crossings, color = TagId)) +
  geom_point(alpha = 0.5) +
  geom_smooth(method = "glm", method.args = list(family = "poisson")) +
  theme_minimal()


### Negative Bionmial ----

model_neg_binomial <- glmmTMB(
  n_crossings ~ TagId + ndvi + (1 | period),
  data = cordon_cross_ndvi_w_periods,
  family = nbinom2
)

summary(model_neg_binomial)

