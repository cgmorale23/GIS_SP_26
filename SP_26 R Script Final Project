  geom_sf(data = kde_95, aes(fill = factor(TagId)), alpha = 0.6, color = "black") +
  geom_sf(data = kde_50, aes(fill = factor(TagId)), alpha = 0.5, color = NA) +
  theme_minimal() +
  labs(fill = "Herd")

